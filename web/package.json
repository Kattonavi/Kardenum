{
  "name": "kardenum-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:short": "playwright test e2e/home.spec.ts e2e/navigation.spec.ts e2e/contact.spec.ts e2e/carousel.spec.ts e2e/faq.spec.ts e2e/fonts.spec.ts e2e/language.spec.ts e2e/layout.spec.ts e2e/security.spec.ts",
    "build": "eslint --max-warnings=0 && next typegen && tsc --noEmit && node --import ./scripts/test-register.mjs --test \"src/**/*.test.ts\" && next build && node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/start.mjs",
    "smoke": "node --import ./scripts/test-register.mjs scripts/smoke.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.2",
    "@types/mdx": "2.0.14",
    "next": "16.4.6",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "22.x"
  }
}
